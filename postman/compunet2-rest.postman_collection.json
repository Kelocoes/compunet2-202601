        {
            "name": "Auth - Login",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.request.headers.remove('Authorization');"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('El status code es 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('El cuerpo es JSON valido', function () {",
                            "    const contentType = pm.response.headers.get('Content-Type') || '';",
                            "    pm.expect(contentType.toLowerCase()).to.include('application/json');",
                            "    pm.expect(function () {",
                            "        pm.response.json();",
                            "    }).to.not.throw();",
                            "});",
                            "",
                            "const loginResponse = pm.response.json();",
                            "const accessToken = loginResponse.accessToken || loginResponse.token || loginResponse.jwt || loginResponse.access_token;",
                            "if (accessToken) {",
                            "    pm.collectionVariables.set('access_token', accessToken);",
                            "    console.log('Access token guardado en variable de coleccion: access_token');",
                            "} else {",
                            "    console.warn('No se encontro access token en la respuesta de login');",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"123456\"\n}"
                },
                "url": "http://localhost:8081/compunet2-2026/rest/public/auth/login"
            }
        },
