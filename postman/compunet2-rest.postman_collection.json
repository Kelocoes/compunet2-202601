        {
            "name": "Games - Create",
            "event": [
                {
                    "listen": "prerequest",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "const randomUserId = Math.floor(Math.random() * 20) + 1;",
                            "const randomGameName = `Catan ${Math.floor(Math.random() * 1000)}`;",
                            "pm.collectionVariables.set('user_id', randomUserId);",
                            "pm.collectionVariables.set('random_game_name', randomGameName);",
                            "",
                            "const payload = {",
                            "    name: randomGameName,",
                            "    description: 'Juego de estrategia espacial',",
                            "    minPlayers: 1,",
                            "    maxPlayers: 5,",
                            "    category: 'Strategy',",
                            "    userId: randomUserId",
                            "};",
                            "pm.request.body.update(JSON.stringify(payload, null, 2));",
                            "",
                            "const accessToken = pm.collectionVariables.get('access_token');",
                            "if (accessToken) {",
                            "    pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${accessToken}` });",
                            "}"
                        ]
                    }
                },
                {
                    "listen": "test",
                    "script": {
                        "type": "text/javascript",
                        "exec": [
                            "pm.test('El status code es 201', function () {",
                            "    pm.response.to.have.status(201);",
                            "});",
                            "",
                            "pm.test('El cuerpo es JSON valido', function () {",
                            "    const contentType = pm.response.headers.get('Content-Type') || '';",
                            "    pm.expect(contentType.toLowerCase()).to.include('application/json');",
                            "    pm.expect(function () {",
                            "        pm.response.json();",
                            "    }).to.not.throw();",
                            "});"
                        ]
                    }
                }
            ],
